 SG_ EXTERNAL_BRAKE_INPUT : 16|1@0+ (1,0) [0|1] "bool" PCM,PROVEN
 SG_ CRUISE_AT_SHIFT_ASSIST_INPUT : 28|1@0+ (1,0) [0|1] "bool" PCM,PROVEN
 SG_ COUNTER : 63|2@0+ (1,0) [0|3] "count" PCM,PROVEN
 SG_ CHECKSUM : 59|4@0+ (1,0) [0|15] "raw" PCM,PROVEN

CM_ SG_ 160 CRUISE_SPEED_LIMIT_ENABLE "Applies in cruise mode 0";
VAL_ 160 EXTERNAL_CRUISE_MODE 0 "external variant0" 1 "external variant1" 2 "ordinary cruise" 3 "invalid or fallback" ;


CM_ BO_ 640 "DISABLED IN THIS FIRMWARE";

BO_ 640 CRUISE_CONTROL_DATA_2: 8 XXX
 SG_ EXTERNAL_CRUISE_SPEED_LIMIT : 7|16@0+ (0.01,0) [0|655.35] "km/h" PCM,PROVEN
